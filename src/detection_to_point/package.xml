<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>detection_to_point</name>
  <version>1.0.0</version>
  <description>
    Converts 2D bounding-box detections (vision_msgs/Detection2DArray) into
    3D world-frame points using the pinhole camera model and TF2.
    Depth is estimated as Z = (object_height * focal_length) / bbox_pixel_height.
    Ported from the sly_see_and_spray package (old robot codebase).
  </description>
  <maintainer email="farms@todo.todo">farms</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>image_geometry</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
